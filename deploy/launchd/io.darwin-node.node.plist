<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.darwin-node.node</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/darwin-node</string>
		<string>--nodename</string>
		<string>CHANGE_ME</string>
		<string>--log-level</string>
		<string>info</string>
		<!--
			Loopback is the safe bind. kubectl logs/exec from a remote API
			server needs the address that server dials (the node InternalIP).
			0.0.0.0 listens on every interface, including untrusted ones.
		-->
		<string>--listen-address</string>
		<string>127.0.0.1</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KUBECONFIG</key>
		<string>/var/lib/darwin-node/kubeconfig</string>
		<key>APISERVER_CERT_LOCATION</key>
		<string>/var/lib/darwin-node/tls.crt</string>
		<key>APISERVER_KEY_LOCATION</key>
		<string>/var/lib/darwin-node/tls.key</string>
		<key>APISERVER_CA_CERT_LOCATION</key>
		<string>/var/lib/darwin-node/ca.crt</string>
		<key>DARWIN_NODE_MAX_VMS</key>
		<string>2</string>
		<key>DARWIN_NODE_NETWORK_MODE</key>
		<string>nat</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!--
		AbandonProcessGroup leaves supervisor sessions alone when launchd
		restarts this job. Setsid gives each supervisor its own process
		group; without this key, kickstart -k still signals that group.
		ProcessType Interactive disables App Nap so the agent heartbeat
		is not deferred into the dead-man window.
	-->
	<key>AbandonProcessGroup</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<!--
		ExitTimeOut is how long launchd waits after SIGTERM before SIGKILL.
		It must stay above the shutdown grace period (default 60s, flag
		shutdown-grace-period, or DARWIN_NODE_SHUTDOWN_GRACE) plus the
		30s Engine.Close deadline and the 5s final reap. Those finish
		the cache-volume snapshot. 120s covers the defaults. Raise this
		integer when the grace period is raised, or launchd kills the
		process and the snapshot does not run.
	-->
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<!--
		These two files grow without a bound until darwin-node.conf is
		installed in /etc/newsyslog.d/. launchd keeps the descriptors
		open, so a rotated file receives new bytes after the job next
		starts. See docs/installation.md.
	-->
	<key>StandardOutPath</key>
	<string>/var/log/darwin-node/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/darwin-node/stderr.log</string>
</dict>
</plist>
